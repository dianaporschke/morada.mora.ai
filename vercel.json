{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/portal-agent.js": {
      "maxDuration": 60
    },
    "api/portal-chat.js": {
      "maxDuration": 60
    },
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/chat-simple.js": {
      "maxDuration": 60
    },
    "api/ai-evaluation.js": {
      "maxDuration": 60
    },
    "api/requests.js": {
      "maxDuration": 30
    },
    "api/ai-readiness.js": {
      "maxDuration": 25
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/portal.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/portal-current.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
