# Server-only configuration. Never paste keys into the portal or commit real secrets.
# Existing defaults remain unchanged until provider/model/cost approval.
MORA_AI_PROVIDER=auto
# Explicit alternatives: gateway or openai. No automatic cross-provider failover.
AI_GATEWAY_API_KEY=
# On Vercel, request-scoped OIDC can replace the Gateway key; do not copy tokens here.
AI_GATEWAY_MODEL=openai/gpt-6-luna
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Use a separate strong, stable signing secret in Vercel environments.
MORA_SESSION_SECRET=
# Enable only after approval and successful preview checks.
MORA_AI_REQUIRED=false
# Optional second model call for natural wording; increases usage. Needs live quality review.
MORA_AI_NATURAL_REPLIES=false
